+/**
+ * Plan 037: Die Nachrichtenliste rendert nur die sichtbaren Zeilen (+ Überhang),
+ * und ein Klick auf eine Zeile rendert nur diese Zeile neu.
+ */
+import React from 'react';
+import { act, fireEvent, render, screen } from '@testing-library/react';
+
+const mockInvoke = jest.fn();
+
+jest.mock('sonner', () => ({
+  toast: Object.assign(jest.fn(), {
+    success: jest.fn(),
+    error: jest.fn(),
+    warning: jest.fn(),
+    info: jest.fn(),
+    message: jest.fn(),
+  }),
+}));
+
+jest.mock('@/services/transport', () => ({
+  getRendererTransport: () => ({ kind: 'ipc' }),
+  invokeRenderer: (...args: unknown[]) => mockInvoke(...args),
+}));
+
+// Zähler je gerenderter Zeile.
+jest.mock('../../src/components/email/sent-provenance', () => ({
+  SentProvenanceBadges: jest.fn(() => null),
+  SentProvenanceLine: () => null,
+}));
+
+const mockWorkspace = {
+  searchQuery: '',
+  setSearchQuery: jest.fn(),
+  searchScope: { allFolders: false },
+  setSearchScope: jest.fn(),
+  searchSortMode: 'relevance',
+  setSearchSortMode: jest.fn(),
+  selectedMessage: null,
+  selectedAccountId: 1,
+  messageListFilter: 'all',
+  messageDoneFilter: 'all',
+  mailView: 'inbox',
+  categoryFilterId: null,
+  listSortMode: 'date_desc',
+  setListSortMode: jest.fn(),
+  listDisplayMode: 'flat' as 'flat' | 'thread',
+  setListDisplayMode: jest.fn(),
+  conversationLocks: {},
+};
+jest.mock('../../src/components/email/workspace-context', () => ({
+  useMailWorkspace: () => mockWorkspace,
+}));
+
+import { IPCChannels } from '../../shared/ipc/channels';
+import { MessageList } from '../../src/components/email/message-list';
+import { SentProvenanceBadges } from '../../src/components/email/sent-provenance';
+import { MAIL_DRAG_TYPE } from '../../src/components/email/mail-drag';
+import type { EmailMessage } from '../../src/components/email/types';
+
+function inbox(id: number, extra: Partial<EmailMessage> = {}): EmailMessage {
+  return {
+    id,
+    account_id: 1,
+    folder_id: 1,
+    uid: id,
+    subject: `Nachricht ${id}`,
+    snippet: null,
+    date_received: '2026-09-20T10:00:00.000Z',
+    from_json: JSON.stringify({ value: [{ address: `absender${id}@example.com` }] }),
+    body_text: null,
+    body_html: null,
+    seen_local: 0,
+    done_local: 0,
+    ...extra,
+  } as EmailMessage;
+}
+
+const MESSAGES = Array.from({ length: 1000 }, (_, i) => inbox(i + 1));
+
+const heightDescriptor = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'offsetHeight');
+const widthDescriptor = Object.getOwnPropertyDescriptor(HTMLElement.prototype, 'offsetWidth');
+
+beforeAll(() => {
+  Object.defineProperty(HTMLElement.prototype, 'offsetHeight', {
+    configurable: true,
+    get(this: HTMLElement) {
+      if (this.hasAttribute('data-index')) return 64;
+      return this.hasAttribute('data-message-list-scroll') ? 640 : 0;
+    },
+  });
+  Object.defineProperty(HTMLElement.prototype, 'offsetWidth', {
+    configurable: true,
+    get() {
+      return 400;
+    },
+  });
+});
+
+afterAll(() => {
+  if (heightDescriptor) Object.defineProperty(HTMLElement.prototype, 'offsetHeight', heightDescriptor);
+  if (widthDescriptor) Object.defineProperty(HTMLElement.prototype, 'offsetWidth', widthDescriptor);
+});
+
+beforeEach(() => {
+  mockInvoke.mockReset();
+  (SentProvenanceBadges as unknown as jest.Mock).mockClear();
+  mockWorkspace.listDisplayMode = 'flat';
+});
+
+function renderList(props: Partial<React.ComponentProps<typeof MessageList>> = {}) {
+  return render(
+    <MessageList messages={MESSAGES} accounts={[]} loading={false} onOpen={jest.fn()} {...props} />,
+  );
+}
+
+describe('MessageList: nur sichtbare Zeilen (Plan 037)', () => {
+  test('von 1000 Mails sind höchstens Sichtbare + Überhang eingehängt', () => {
+    const { container } = renderList();
+    const mounted = container.querySelectorAll('[data-message-id]').length;
+    expect(mounted).toBeGreaterThan(0);
+    expect(mounted).toBeLessThanOrEqual(40);
+  });
+
+  test('Häkchen an einer Zeile rendert nur diese Zeile neu', () => {
+    renderList();
+    const badges = SentProvenanceBadges as unknown as jest.Mock;
+    const before = badges.mock.calls.length;
+    expect(before).toBeGreaterThan(0);
+    fireEvent.click(screen.getByRole('checkbox', { name: 'Nachricht 1 auswählen' }));
+    expect(badges.mock.calls.length - before).toBeLessThanOrEqual(2);
+  });
+
+  test('scrollToMessageId: geladene Zeile wird angesteuert, fehlende bleibt offen', () => {
+    const scrolled = jest.fn();
+    const { unmount } = renderList({ scrollToMessageId: 900, onScrolledToMessage: scrolled });
+    expect(scrolled).toHaveBeenCalledTimes(1);
+    unmount();
+    const missing = jest.fn();
+    renderList({ scrollToMessageId: 9999, onScrolledToMessage: missing });
+    expect(missing).not.toHaveBeenCalled();
+  });
+
+  test('Shift-Klick wählt einen Bereich aus', () => {
+    renderList();
+    fireEvent.click(screen.getByRole('checkbox', { name: 'Nachricht 1 auswählen' }));
+    fireEvent.click(screen.getByRole('checkbox', { name: 'Nachricht 3 auswählen' }), { shiftKey: true });
+    expect(screen.getByText('3 ausgewählt')).toBeInTheDocument();
+  });
+
+  test('Ziehen einer ausgewählten Zeile nimmt die ganze Auswahl mit', () => {
+    const { container } = renderList();
+    fireEvent.click(screen.getByRole('checkbox', { name: 'Nachricht 1 auswählen' }));
+    fireEvent.click(screen.getByRole('checkbox', { name: 'Nachricht 2 auswählen' }));
+    const row = container.querySelector('[data-message-id="2"]')!;
+    const dataTransfer = { setData: jest.fn(), effectAllowed: '' };
+    fireEvent.dragStart(row, { dataTransfer });
+    expect(dataTransfer.setData).toHaveBeenCalledWith(
+      MAIL_DRAG_TYPE,
+      JSON.stringify({ messageId: 1, messageIds: [1, 2] }),
+    );
+  });
+
+  test('Thread aufklappen lädt die Nachrichten des Threads', async () => {
+    mockWorkspace.listDisplayMode = 'thread';
+    mockInvoke.mockResolvedValue([inbox(11, { thread_id: 'th-a' }), inbox(12, { thread_id: 'th-a' })]);
+    const threadMessages = [
+      inbox(11, { thread_id: 'th-a', thread_message_count: 2 }),
+      inbox(12, { thread_id: 'th-a', thread_message_count: 2 }),
+    ];
+    const { container } = renderList({ messages: threadMessages });
+    const row = container.querySelector('[data-message-id="11"]')!;
+    const expand = row.parentElement!.querySelector('button:not([data-message-id]):not([role="checkbox"])')!;
+    await act(async () => {
+      fireEvent.click(expand);
+    });
+    expect(mockInvoke).toHaveBeenCalledWith(IPCChannels.Email.ListThreadMessages, { threadId: 'th-a', limit: 50 });
+  });
+});
