{$PUBLIC_DOMAIN:localhost} {
	encode gzip zstd
	@tracking path /t/*
	log_skip @tracking

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; media-src 'self' data: blob: https: http:; frame-src 'self' blob: https://challenges.cloudflare.com; worker-src 'self' blob:; connect-src 'self' ws://{http.request.host} wss://{http.request.host} https://challenges.cloudflare.com; manifest-src 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-X-Powered-By
	}

	# HSTS closes the plain-http first visit that SSL stripping relies on. One
	# year, without includeSubDomains and preload: those would bind the
	# operator's other subdomains and the browser preload list, which is their
	# call (docs/SETUP_SERVER.md). Not for localhost: browsers apply HSTS to every
	# port of a host, so a local test run would lock other local http services.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"

	# API, public email evidence endpoints, health probes, OpenAPI and the
	# SSE/WebSocket event stream (/api/v1/events) go to Fastify. Tracking URLs
	# are intentionally excluded from access logs because their paths contain
	# bearer-like opaque tokens.
	# Spoofable identity headers are stripped before requests reach Fastify.
	@backend path /api/* /t/* /health /health/* /openapi.json
	handle @backend {
		# Defense in depth: Fastify caps request bodies per route (1 MiB, 40 MiB
		# for the compose and PGP upload routes); nothing larger reaches the API.
		request_body {
			max_size 40MiB
		}
		reverse_proxy api:3000 {
			header_up -x-simplecrm-user-id
			header_up -x-simplecrm-workspace-id
			header_up -x-simplecrm-role
		}
	}

	# Single-page app: serve built assets, fall back to index.html for client routes.
	handle {
		root * /srv/dist
		try_files {path} /index.html
		file_server
	}

	# Other bearer-like secrets are redacted rather than skipped, so the requests
	# stay visible. Caddy on its own only hides Cookie and Authorization: the
	# event stream carries the access token as WebSocket subprotocol (echoed in
	# the response), and invitation links carry the invitation token in the path
	# (/api/v1/auth/invitations/<token>) or the query (/login?invite=<token>).
	# Rotation sized for small servers: 25 MiB per file, at most 4 old files,
	# none older than 14 days (Caddy's default would keep 10 x 100 MiB).
	log {
		output file /var/log/access.log {
			roll_size 25MiB
			roll_keep 4
			roll_keep_for 336h
		}
		format filter {
			wrap json
			fields {
				request>headers>Sec-Websocket-Protocol delete
				resp_headers>Sec-Websocket-Protocol delete
				request>uri regexp "(/api/v1/auth/invitations/|[?&]invite=)[^/?&#]+" "$1[redacted]"
			}
		}
	}
}
